APP_NAME="Asterisk Administration"
APP_URL=http://localhost:8080
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_HTTP_PORT=8080
SESSION_SECURE_COOKIE=false

# Disabled until a dedicated database role and remote access are approved.
# Use a DNS name or IP address, never a PBX Compose service name.
REALTIME_ENABLED=false
REALTIME_DB_HOST=pbx.example.invalid
REALTIME_DB_PORT=5432
REALTIME_DB_DATABASE=asterisk
REALTIME_DB_USERNAME=laravel_readonly
REALTIME_DB_PASSWORD=
REALTIME_DB_SSLMODE=prefer

# Separate writer role; inventory continues using the reader connection.
REALTIME_WRITES_ENABLED=false
REALTIME_WRITE_DB_USERNAME=
REALTIME_WRITE_DB_PASSWORD=
REALTIME_TRANSPORTS=transport-udp
