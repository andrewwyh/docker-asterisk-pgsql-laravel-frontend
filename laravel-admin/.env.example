APP_NAME="Asterisk Administration"
# Replace with this administration host's HTTPS URL from tailscale serve status.
APP_URL=https://your-admin-host.your-tailnet.ts.net
# Tailscale terminates HTTPS and proxies to this loopback-only HTTP listener.
# Start it with: tailscale serve --bg --https=443 http://127.0.0.1:8080
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_HTTP_PORT=8080
SESSION_SECURE_COOKIE=true

# Comma-separated trusted proxy IPs/CIDRs. For host Tailscale Serve, set this
# to the admin Docker network gateway on the deployment host. Find it with:
# docker network inspect asterisk-admin_admin --format '{{(index .IPAM.Config 0).Gateway}}'
# Set after the Compose network exists; update if its gateway changes.
# No default IP is supplied because the address depends on the host.
TRUSTED_PROXIES=
# For local HTTP-only development: APP_URL=http://localhost:8080 and
# SESSION_SECURE_COOKIE=false. Leave TRUSTED_PROXIES empty without a proxy.

# Disabled until a dedicated database role and remote access are approved.
# Use the PBX host's DNS name or Tailscale IP, never a PBX Compose service name.
REALTIME_ENABLED=false
REALTIME_DB_HOST=pbx.example.invalid
REALTIME_DB_PORT=5432
REALTIME_DB_DATABASE=asterisk
REALTIME_DB_USERNAME=laravel_readonly
REALTIME_DB_PASSWORD=
REALTIME_DB_SSLMODE=prefer

# Separate writer role; inventory continues using the reader connection.
REALTIME_WRITES_ENABLED=false
REALTIME_WRITE_DB_USERNAME=
REALTIME_WRITE_DB_PASSWORD=
REALTIME_TRANSPORTS=transport-udp
